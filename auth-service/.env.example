# Copy to .env for running this service directly with uvicorn (no Docker).
# When running via docker-compose, the root .env is used instead.
# Async driver required: postgresql+asyncpg://

DATABASE_URL=postgresql+asyncpg://<user>@localhost:5432/auth_db
REDIS_URL=redis://localhost:6379/0
# MUST match the product-service secret — generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development
