# Copy to .env for running this service directly with uvicorn (no Docker).
# When running via docker-compose, the root .env is used instead.
# Async driver required: postgresql+asyncpg://

DATABASE_URL=postgresql+asyncpg://<user>@localhost:5432/product_db
REDIS_URL=redis://localhost:6379/1
# MUST be the same secret as the Auth Service — that's how tokens are trusted
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ENVIRONMENT=development
