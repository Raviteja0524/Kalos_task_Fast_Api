# Copy this file to .env (cp .env.example .env) — docker-compose reads it
# for variable substitution. The real .env is gitignored; never commit it.
#
# host.docker.internal = your machine as seen from inside Docker containers.
# Replace <user> with your local PostgreSQL username (your OS username for
# Homebrew/Postgres.app installs). Add :<password> after the user if your
# Postgres requires one, e.g. postgresql+asyncpg://postgres:secret@host...

AUTH_DATABASE_URL=postgresql+asyncpg://<user>@host.docker.internal:5432/auth_db
PRODUCT_DATABASE_URL=postgresql+asyncpg://<user>@host.docker.internal:5432/product_db

# Shared HS256 secret — both services MUST use the same value.
# Generate one with: openssl rand -hex 32
JWT_SECRET_KEY=change-me

ENVIRONMENT=development
